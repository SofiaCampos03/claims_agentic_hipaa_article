# Copy this file to .env and fill in the values:   cp .env.example .env
# .env is git-ignored. Never commit it. The notebook loads it at the top of Section 1, and its values win over the shell's.

# ---- Required -------------------------------------------------------------------------------
GROQ_API_KEY=                          # https://console.groq.com

# ---- Recommended ----------------------------------------------------------------------------
# Secret used to build the PAYER-xxxxxx / CLAIM-xxxxxx pseudonyms. If empty, a random one is made each run,
# so pseudonyms change between runs. Generate one with:   python -c "import secrets; print(secrets.token_hex(16))"
PSEUDONYM_SALT=

# ---- Optional overrides (defaults shown) ----------------------------------------------------
# LLM
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b
# LLM_TEMPERATURE=0.1
# LLM_MAX_RETRIES=8

# Paths (relative to the repository root)
# DOCS_DIR=docs
# RAG_CACHE_DIR=.rag_cache
# TRAINING_CSV=data/claim_metrics.csv
# FEATURE_SPEC_PATH=config/feature_spec_xgboost.yaml
# CODE_LABELS_PATH=config/code_labels.csv
# TRAIN_OUT_DIR=artifacts

# Embeddings + RAG
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# HIPAA_DOCS=summary_HIPAA.md
# RAG_CHUNK_SIZE=1200
# RAG_CHUNK_OVERLAP=150
# RAG_CONTEXTUALIZE=1
# RAG_CONCURRENCY=6
# RRF_K=60
# RAG_TOP_K=5

# Training
# RUN_TRAINING=0
# TUNE_N_TRIALS=30
# TUNE_SCORING=f1
# CV_FOLDS=5
# TEST_SIZE=0.2
# RANDOM_STATE=42
# TRAIN_SAMPLE=0
# XGB_N_JOBS=4
# DENIED_STATUSES=rejected,partially_paid
# KEPT_STATUSES=rejected,partially_paid,paid,accepted,approved
# DECISION_THRESHOLD=0.5

# GNN analytics
# GNN_MIN_DF=25
# GNN_MIN_SUPPORT=30
# GNN_TRIPLES=1
# GNN_MAX_TRIPLE_CODES=1500
# GNN_HOPS=2
# GNN_HIDDEN=64
# GNN_EPOCHS=200
# GNN_LR=1e-2
# GNN_DROPOUT=0.1
# GNN_DEVICE=auto
# TORCH_NUM_THREADS=1
# FORCE_RECOMPUTE=0

# Privacy
# PSEUDONYMISE_CLAIM_IDS=1
# NON_INSURER_PAYERS=Self-pay
# EXTRA_INSURER_NAMES=
